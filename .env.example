# Titan Nova Termux / server environment template
# Copy values into your shell or .env manager. Do not commit real secrets.

# Firebase Realtime Database root JSON URL.
# Example format: https://YOUR-PROJECT-default-rtdb.firebaseio.com/titan_master_data.json
FIREBASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com/titan_master_data.json
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com/titan_master_data.json

# Admin and Gateway tokens. Keep both same for simple local deploy, or separate for production.
TITAN_ADMIN_TOKEN=change-this-admin-token
TITAN_GATEWAY_TOKEN=change-this-gateway-token
TITAN_FLASK_SECRET=change-this-long-random-secret

# Flask -> Gateway connection.
# Same phone Termux: http://127.0.0.1:3000
# Different phone/LAN: http://PHONE-IP:3000 and run Gateway with HOST=0.0.0.0
GATEWAY_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000

# Runtime timezone and business-day boundary.
APP_TZ=Asia/Kolkata
TITAN_BUSINESS_DAY_CUTOFF_HOUR=6

# Stability tuning. Keep defaults unless testing.
TITAN_REALTIME_FAST_SYNC=1
TITAN_STATE_CACHE_TTL_MS=250
TITAN_SMOKE_STRICT=0

# Optional payment image upload proxy.
IMGBB_API_KEY=

# Optional result scrape toggle.
RESULT_SCRAPE_ENABLED=1
RESULT_SCRAPE_INTERVAL_MS=5000
