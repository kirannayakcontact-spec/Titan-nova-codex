# Titan Nova Termux environment template
# Copy the exports below into ~/.bashrc, then run: source ~/.bashrc

# REQUIRED: set this to your Firebase Realtime Database JSON path.
# Example format:
# export FIREBASE_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com/titan_master_data.json"
export FIREBASE_URL=""

# Keep Flask and Gateway on same business clock.
export APP_TZ="Asia/Kolkata"
export TITAN_BUSINESS_DAY_CUTOFF_HOUR="6"

# Flask talks to Gateway on this local URL when both run on same phone/Termux.
export GATEWAY_URL="http://127.0.0.1:3000"

# Optional but recommended for admin/gateway security.
# Use the same value in both Python and Node sessions.
export TITAN_ADMIN_TOKEN=""
export TITAN_GATEWAY_TOKEN=""

# Gateway bind config. Keep 127.0.0.1 for same-device local use.
export HOST="127.0.0.1"
export PORT="3000"

# Result source override. Keep these explicit so scrape changes do not depend on old defaults.
export RESULT_SOURCE_NAME="DPBosse"
export RESULT_SOURCE_URL="https://dpbosse.net/"
export RESULT_SCRAPE_URLS="https://dpbosse.net/"
