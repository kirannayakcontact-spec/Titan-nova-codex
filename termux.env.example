# Titan Nova Termux environment template
# Copy the exports below into ~/.bashrc, then run: source ~/.bashrc

# Local SQLite is the default source of truth. The app stores the full state
# in one transactional SQLite row and does not contact Firebase in this mode.
export TITAN_STORAGE_MODE="sqlite"
# Bookie-only product: WhatsApp game replies, payments, results and admin activity.
export TITAN_BOOKIE_ONLY_MODE="1"
# Results remain available through manual/admin result publishing; website scraping is off.
export RESULT_SCRAPE_ENABLED="0"
# Optional absolute path. Default: $TITAN_STATE_DIR/titan_nova.sqlite3
# export TITAN_SQLITE_PATH="$HOME/Titan-nova-codex/titan_nova.sqlite3"
# Short cache keeps dashboard polling fast; use 0 only for strict no-cache debugging.
export TITAN_SQLITE_CACHE_TTL_MS="250"

# Only set FIREBASE_URL if you intentionally switch back to remote Firebase mode:
# export TITAN_STORAGE_MODE="firebase"
# export FIREBASE_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com/titan_master_data.json"

# Keep Flask and Gateway on same business clock.
export APP_TZ="Asia/Kolkata"
export TITAN_BUSINESS_DAY_CUTOFF_HOUR="6"

# Flask talks to Gateway on this local URL when both run on same phone/Termux.
export GATEWAY_URL="http://127.0.0.1:3000"

# Direct-open local mode: no admin or gateway token is required.

# Gateway bind config. Keep 127.0.0.1 for same-device local use.
export HOST="127.0.0.1"
export PORT="3000"

# Result source override. Keep these explicit so scrape changes do not depend on old defaults.
export RESULT_SOURCE_NAME="Dpbosss Net In"
export RESULT_SOURCE_URL="https://dpbosss.net.in/"
export RESULT_SCRAPE_URLS="https://dpbosss.net.in/"
# Five-bot command allowlists (comma-separated international-format numbers).
# Public game messages remain unrestricted; commands to these privileged bots
# are silently ignored unless the sender appears here.
export WHATSAPP_FINANCE_BOT_ADMINS="919876543210"
export WHATSAPP_RESULT_BOT_ADMINS="919876543210"
export WHATSAPP_LEDGER_BOT_ADMINS="919876543210"
# Shared fallback used when a role-specific allowlist is not supplied:
export TITAN_AUTHORIZED_WHATSAPP_NUMBERS="919876543210"
